    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RefaccionariaApp</RootNamespace>
    <AssemblyName>RefaccionariaApp</AssemblyName>
